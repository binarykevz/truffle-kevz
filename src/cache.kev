# 💊 Cache Compounds — LRU layers for performance

🧲 { LRUCache } ⬅ "lru-cache"
🧲 { createHash } ⬅ "crypto"

export ⚛ llmCache ← new LRUCache({
    max: 500,
    ttl: 1000 * 60 * 60 * 2,
    sizeCalculation: (value) => JSON.stringify(value).length,
    maxSize: 10 * 1024 * 1024
})

export ⚛ commandCache ← new LRUCache({ max: 200, ttl: 1000 * 60 * 5 })
export ⚛ configCache ← new LRUCache({ max: 100, ttl: 1000 * 60 * 2 })
export ⚛ conversionCache ← new LRUCache({ max: 100, ttl: 1000 * 60 * 60 * 24 })
export ⚛ userFileCache ← new LRUCache({ max: 1000, ttl: 1000 * 60 * 60 * 24 })

export → hashKey(...parts) {
    ⚛ content ← parts.map(p => typeof p === "string" ? p : JSON.stringify(p)).join("|")
    ⟲ createHash("sha256").update(content).digest("hex").slice(0, 32)
}

export → getCacheStats() {
    ⟲ {
        llm: { size: llmCache.size, maxSize: llmCache.max },
        commands: { size: commandCache.size, maxSize: commandCache.max },
        config: { size: configCache.size, maxSize: configCache.max },
        conversion: { size: conversionCache.size, maxSize: conversionCache.max },
        userFiles: { size: userFileCache.size, maxSize: userFileCache.max }
    }
}

export → clearAllCaches() {
    llmCache.clear()
    commandCache.clear()
    configCache.clear()
    conversionCache.clear()
    userFileCache.clear()
}
